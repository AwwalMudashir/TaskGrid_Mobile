{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api--taskgrid-server--glqzmhjlzbpt.code.run/api/v1",
        "EXPO_PUBLIC_API_URL_RENDER_FALLBACK": "https://taskgrid-backend.onrender.com/api/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api--taskgrid-server--glqzmhjlzbpt.code.run/api/v1",
        "EXPO_PUBLIC_API_URL_RENDER_FALLBACK": "https://taskgrid-backend.onrender.com/api/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
